DISCORD_TOKEN=your_discord_bot_token_here

# 선택 (없으면 토큰에서 자동 추출)
# DISCORD_CLIENT_ID=your_discord_application_client_id

# /redeem, /dashboard 키·상점 기능용 (선택)
# GITHUB_TOKEN=your_github_personal_access_token
# GITHUB_OWNER=your_github_username
# GITHUB_REPO=discord-game-bot

# 토스 자동충전(입금 웹훅)용 (선택)
# 폰 브리지(MacroDroid 등)와 공유하는 비밀키. 설정해야 /deposit 웹훅이 동작합니다.
# DEPOSIT_SECRET=long_random_secret_here
# 충전 모달에서 안내할 입금 계좌 정보(여러 줄 가능)
# DEPOSIT_ACCOUNT_INFO=토스뱅크 1000-0000-0000 (예금주: 홍길동)
# 자동충전/미매칭 알림을 남길 채널 ID (선택)
# DEPOSIT_LOG_CHANNEL_ID=000000000000000000
# 미매칭 티켓을 만들 서버 ID (미설정 시 봇이 속한 첫 서버)
# GUILD_ID=000000000000000000
# 입금 요청 유효 시간(ms), 기본 30분 / 금액 충돌 시 최대 추가 원, 기본 99
# DEPOSIT_REQUEST_TTL_MS=1800000
# DEPOSIT_MAX_OFFSET=99
